<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EEEEEE"
    android:padding="8dp">

    <!-- Nombre del ejercicio y 1RM estimado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:id="@+id/tvNombreEjercicio"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:text="Nombre Ejercicio"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv1RM"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:text="1RM Estimado: 0 KG"
            android:textSize="14sp"
            android:textAlignment="textEnd" />
    </LinearLayout>

    <!-- Título de la mejor marca + fecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mejor marca registrada:"
            android:textSize="15sp"
            android:textStyle="italic"
            android:textColor="@android:color/darker_gray" />

        <TextView
            android:id="@+id/tvFechaMejorMarca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 22/05/2024"
            android:textSize="15sp"
            android:textStyle="italic"
            android:textColor="@android:color/darker_gray"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Peso (KG)"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Reps"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="RPE"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Datos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvMejorPeso"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="100.0"
            android:textAlignment="center"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMejoresReps"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="8"
            android:textAlignment="center"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMejorRPE"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="7.5"
            android:textAlignment="center"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Botón de gráfica -->
    <Button
        android:id="@+id/btnToggleDetalles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ver Gráfica"
        android:textColor="@android:color/white"
        android:background="@drawable/button_background_2"
        app:backgroundTint="@null"
        android:layout_gravity="end" />

    <!-- Contenedor oculto -->
    <LinearLayout
        android:id="@+id/llDetallesEjercicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="8dp" />

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#CCCCCC" />

</LinearLayout>
