<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_buzon"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <!--  Botón para alternar entre recibidos / enviados  -->
    <!--  RecyclerView que muestra los mensajes  -->
    <TextView
        android:id="@+id/textView10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Buzón"
        android:textColor="@color/white"
        android:textSize="40dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.086"
        tools:layout_editor_absoluteX="16dp" />

    <Button
        android:id="@+id/btnFilterMensajes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ver enviados"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView10"
        app:layout_constraintVertical_bias="0.084" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMensajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/verde_transparente"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnFilterMensajes"
        tools:layout_editor_absoluteX="16dp" />

    <TextView
        android:id="@+id/noHayMensajes"
        android:layout_width="183dp"
        android:layout_height="240dp"
        android:text="No hay mensajes en el buzón"
        android:textColor="@color/white"
        android:textSize="40dp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/rvMensajes"
        app:layout_constraintEnd_toEndOf="@+id/rvMensajes"
        app:layout_constraintStart_toStartOf="@+id/rvMensajes"
        app:layout_constraintTop_toTopOf="@+id/rvMensajes" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="219dp"
        android:layout_height="182dp"
        android:text="No hay mensajes actualmente"
        android:textColor="@color/white"
        android:textSize="30dp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/rvMensajes"
        app:layout_constraintEnd_toEndOf="@+id/rvMensajes"
        app:layout_constraintStart_toStartOf="@+id/rvMensajes"
        app:layout_constraintTop_toTopOf="@+id/rvMensajes" />
</androidx.constraintlayout.widget.ConstraintLayout>